# Python virtual environments
.venv/
venv/
env/

# Python cache and build artifacts
__pycache__/
*.py[cod]
*.pyd
build/
dist/
*.egg-info/

# Environment variables and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Development caches and coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Raw satellite and other source data must never be committed.
data/raw/**
!data/raw/.gitkeep

# Generated processed outputs (keep the directory placeholder)
data/processed/**
!data/processed/.gitkeep

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Repository-packaged, attributed PNS02 demonstration vectors are intentionally trackable.
!data/demo/
!data/demo/pns02/
!data/demo/pns02/**
# Keep any future research archives and raw data excluded.
data/demo/**/*.zip
